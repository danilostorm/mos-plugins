#!/usr/bin/python3
"""Restricted MOS query entrypoint: no arbitrary executable or file arguments."""
import sys
sys.path.insert(0, "/usr/lib/mos-resource-guardian")
from service import client
import json

try:
    if len(sys.argv) < 2 or sys.argv[1] not in ("status", "history", "config", "configure", "discover", "pause", "automatic", "observe", "restore"):
        raise ValueError("Invalid operation")
    op = sys.argv[1]
    if len(sys.argv) != (3 if op == "configure" else 2):
        raise ValueError("Invalid arguments")
    print(json.dumps(client(op, payload=sys.argv[2] if op == "configure" else None), allow_nan=False))
except Exception as exc:
    print(json.dumps({"error": str(exc)}))
    sys.exit(1)
